HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
RAG_SERVICE_TOKEN=
# Keep the original collection name: renaming the product does not rename stored vectors.
VECTOR_COLLECTION_NAME=nyayasetu_legal_documents
MAX_RETRIEVAL_ATTEMPTS=2
MAX_CONTEXT_CHUNKS=12
MAX_CONTEXT_CHARS=28000
RETRIEVAL_MODE=hybrid
ENABLE_RERANKER=true
DEBUG_RETRIEVAL=false
MAX_SEARCH_QUERIES=12
MAX_PLANNED_ISSUES=8

# Two in-flight questions; local model inference remains serialized.
MAX_CONCURRENT_QUERIES=2
# One provider attempt per stage; set 2 only if latency is acceptable.
LLM_MAX_ATTEMPTS=2
LLM_TIMEOUT_SECONDS=20
